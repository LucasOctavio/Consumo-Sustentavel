      },
      "edgeToEdgeEnabled": false,
      "package": "com.fernandotmgomes.CCN"
    },
    "web": {
      "favicon": "./assets/cena.png"
    },
    "plugins": ["expo-web-browser"],
    "extra": {
      "eas": {
        "projectId": "5fadbed1-370a-4b9e-8d85-7092ec3da215"
      }
    },
    "owner": "fernandotmgomes"
  }
