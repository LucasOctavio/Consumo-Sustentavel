{
  "expo": {
    "name": "CENA",
    "slug": "CCN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cena.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
